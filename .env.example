SHOPIFY_APP_URL=http://localhost:3000
SCOPES=write_app_proxy
DATABASE_URL=file:./dev.sqlite
# Optional Docker host port; keep SHOPIFY_APP_URL's local port in sync.
ROMAN_ADMIN_PORT=3000
