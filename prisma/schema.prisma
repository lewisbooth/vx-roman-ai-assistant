// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Conversation {
  id                  String                @id
  shop                String
  origin              String
  credentialHash      String                @unique
  credentialExpiresAt DateTime
  turnCount           Int                   @default(0)
  nextSequence        Int                   @default(0)
  revision            Int                   @default(0)
  status              String                @default("active")
  pendingRequestId    String?
  memoJson            String                @default("{}")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  messages            ConversationMessage[]
  toolInvocations     ToolInvocation[]
  voiceSessions       VoiceSession[]
  voiceTranscripts    VoiceTranscript[]
  modelUsage          ModelUsage[]
  measurementDrafts   MeasurementDraft[]
  measurementWrites   MeasurementWriteReceipt[]
  contexts            ConversationContext[]
  galleryOwnerId      String?
  galleryOwner        GalleryOwner? @relation(fields: [galleryOwnerId], references: [id])
  selectedWindowPhotoId String?
  windowPhotos        WindowPhoto[]
  visualizationJobs   VisualizationJob[]
  imageAttempts       ImageGenerationAttempt[]

  @@index([shop, createdAt])
}

model GalleryOwner {
  id             String @id
  shop           String
  origin         String
  tokenHash      String @unique
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  revokedAt      DateTime?
  conversations  Conversation[]
  windows        WindowPhoto[]
  jobs           VisualizationJob[]
  @@index([shop, createdAt])
}

model WindowPhoto {
  id             String @id
  ownerId        String
  owner          GalleryOwner @relation(fields: [ownerId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  requestId      String
  requestHash    String
  title          String
  revision       Int @default(1)
  assetKey       String
  sha256         String
  width          Int
  height         Int
  bytes          Int
  cleanup        Boolean @default(true)
  consentVersion String
  consentAt      DateTime
  uploadStatus   String @default("saving")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  jobs           VisualizationJob[]
  @@unique([ownerId, requestId])
  @@index([ownerId, createdAt, id])
}

model VisualizationJob {
  id             String @id
  ownerId        String
  owner          GalleryOwner @relation(fields: [ownerId], references: [id])
  windowId       String
  window         WindowPhoto @relation(fields: [windowId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  requestId      String
  requestHash    String
  windowRevision Int
  windowTitle    String
  sourceAssetKey String
  productPath    String
  productTitle   String
  productJson    String @default("{}")
  referencesJson String @default("[]")
  cleanup        Boolean
  targetDescription String?
  promptVersion  String
  status         String @default("awaiting_product")
  width          Int
  height         Int
  reservedBytes  Int @default(10485760)
  resultKey      String?
  resultBytes    Int?
  error          String?
  claimClientId  String?
  claimTokenHash String?
  claimExpiresAt DateTime?
  deadlineAt     DateTime
  createdAt      DateTime @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  deletedAt      DateTime?
  attempts       ImageGenerationAttempt[]
  @@unique([ownerId, requestId])
  @@index([ownerId, createdAt, id])
  @@index([status, deadlineAt])
}

model ImageGenerationAttempt {
  id              String @id
  jobId           String
  job             VisualizationJob @relation(fields: [jobId], references: [id])
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  ordinal         Int
  model           String
  status          String @default("pending")
  providerRequestId String?
  errorCode       String?
  textInputTokens Int?
  textCachedInputTokens Int?
  imageInputTokens Int?
  imageCachedInputTokens Int?
  imageOutputTokens Int?
  usageValid      Boolean @default(false)
  usageJson       String?
  rateSnapshotJson String
  costUsd         Float?
  costEvidence    String @default("unknown")
  costReason      String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  @@unique([jobId, ordinal])
  @@index([conversationId, createdAt])
}

// Provider-owned compacted windows are private and model-specific. The original
// transcript remains the source of truth, independently of these checkpoints.
model ConversationContext {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  model          String
  throughSequence Int
  inputJson      String
  updatedAt      DateTime @updatedAt

  @@id([conversationId, model])
}

model ConversationMessage {
  id             String       @id
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId      String
  sequence       Int
  role           String
  status         String
  partsJson      String       @default("[]")
  error          String?
  model          String?
  serviceTier    String?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
  toolInvocations ToolInvocation[]
  modelUsage     ModelUsage[]

  @@unique([conversationId, requestId, role])
  @@unique([conversationId, sequence])
  @@index([conversationId, completedAt, sequence])
}

model ToolInvocation {
  id               String              @id
  conversationId   String
  conversation     Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assistantId      String
  assistant        ConversationMessage @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  providerCallId   String
  name             String
  argumentsJson    String
  status           String              @default("pending")
  claimClientId    String?
  claimTokenHash   String?
  productIdsJson   String?
  resultJson       String?
  confirmedAt      DateTime?
  error            String?
  createdAt        DateTime            @default(now())
  completedAt      DateTime?

  @@unique([conversationId, providerCallId])
  @@index([conversationId, status])
}

model MeasurementDraft {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  productPath    String
  width          Float
  height         Float
  unit           String
  kind           String
  mount          String
  updatedAt      DateTime

  @@id([conversationId, productPath])
}

model MeasurementWriteReceipt {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId      String
  argumentsJson  String
  resultJson     String
  createdAt      DateTime @default(now())

  @@id([conversationId, requestId])
}

model VoiceSession {
  id             String            @id
  closeReason    String?
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientId       String
  providerId     String?
  model          String?
  usageSeconds   Float?
  status         String            @default("starting")
  leaseExpiresAt DateTime
  createdAt      DateTime          @default(now())
  closedAt       DateTime?
  error          String?
  transcripts    VoiceTranscript[]

  // The migration additionally enforces one starting/active session per conversation.
  @@index([conversationId, status])
}

model ModelUsage {
  id                 String              @id
  conversationId     String
  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assistantId        String
  assistant          ConversationMessage @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  model              String
  serviceTier        String?
  status             String
  inputTokens        Int?
  cachedInputTokens  Int?
  cacheWriteInputTokens Int?
  outputTokens       Int?
  reasoningTokens    Int?
  totalTokens        Int?
  createdAt          DateTime            @default(now())
  completedAt        DateTime?

  @@index([conversationId, createdAt])
}

model VoiceTranscript {
  id              String       @id
  voiceId         String
  voice           VoiceSession @relation(fields: [voiceId], references: [id], onDelete: Cascade)
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerEventId String
  sequence        Int
  role            String
  text            String
  startMs         Float
  endMs           Float
  createdAt       DateTime     @default(now())

  @@unique([voiceId, providerEventId])
  @@unique([conversationId, sequence])
  @@index([conversationId, role, sequence])
}

model ApiIncident {
  id            String    @id
  kind          String
  startedAt     DateTime
  startedDayUtc String
  endedAt       DateTime?

  @@index([startedDayUtc, kind])
  @@index([startedAt])
}
