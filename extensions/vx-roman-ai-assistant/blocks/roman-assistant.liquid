<roman-ai-assistant
  data-shop="{{ shop.permanent_domain | escape }}"
  data-label="{{ 'assistant.name' | t | escape }}"
  data-initial="{{ 'assistant.initial' | t | escape }}"
  data-script-url="{{ 'roman-assistant.bundle.js' | asset_url }}"
  data-logo-url="{{ 'roman-logo.svg' | asset_url }}"
  data-wordmark-url="{{ 'roman-wordmark.svg' | asset_url }}"
  data-texture-url="{{ 'ivory-texture.png' | asset_url }}"
  data-agent-profile-url="{{ 'roman-agent-profile.json' | asset_url }}"
></roman-ai-assistant>

{% schema %}
{
  "name": "t:assistant.name",
  "target": "body",
  "javascript": "roman-assistant-loader.bundle.js",
  "settings": []
}
{% endschema %}
