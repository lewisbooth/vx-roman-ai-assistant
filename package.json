{
  "name": "vx-roman-ai-assistant",
  "packageManager": "npm@10.9.2",
  "private": true,
  "scripts": {
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "node frontend/build.mjs",
    "build:admin": "prisma generate && react-router build",
    "dev": "npm run build:frontend && shopify app dev",
    "dev:admin": "react-router dev",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "watch:frontend": "node frontend/build.mjs --watch",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "npm run check && npm run build:frontend && shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "prisma migrate deploy && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "vite": "vite",
    "typecheck": "prisma generate && react-router typegen && tsc --noEmit",
    "test": "node --test frontend/tests/*.test.mjs admin/tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "openai": "^7.15.0",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@shopify/polaris-types": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "overrides": {
    "qs": "^6.16.0",
    "@prisma/config": {
      "deepmerge-ts": "8.0.1"
    }
  },
  "author": "lewis"
}
